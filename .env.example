# OpenSQT 环境变量示例
# 复制为 .env 后填写。非空项会覆盖 config.yaml 中的同名配置。
# 空值不会覆盖 YAML。
#
#   cp .env.example .env
#   docker compose up -d
#
# 容器内建议把面板绑到 0.0.0.0，并设置 OPENSQT_DASHBOARD_TOKEN。

# 配置文件路径（命令行参数优先）
# OPENSQT_CONFIG=/app/config.yaml
# OPENSQT_ENV_FILE=.env

TZ=Asia/Shanghai

# --- 交易所 ---
OPENSQT_APP_CURRENT_EXCHANGE=bitget

OPENSQT_EXCHANGES_BINANCE_API_KEY=
OPENSQT_EXCHANGES_BINANCE_SECRET_KEY=
OPENSQT_EXCHANGES_BINANCE_FEE_RATE=

OPENSQT_EXCHANGES_BITGET_API_KEY=
OPENSQT_EXCHANGES_BITGET_SECRET_KEY=
OPENSQT_EXCHANGES_BITGET_PASSPHRASE=
OPENSQT_EXCHANGES_BITGET_FEE_RATE=

OPENSQT_EXCHANGES_BYBIT_API_KEY=
OPENSQT_EXCHANGES_BYBIT_SECRET_KEY=
OPENSQT_EXCHANGES_BYBIT_FEE_RATE=

OPENSQT_EXCHANGES_GATE_API_KEY=
OPENSQT_EXCHANGES_GATE_SECRET_KEY=
OPENSQT_EXCHANGES_GATE_FEE_RATE=

OPENSQT_EXCHANGES_EDGEX_API_KEY=
OPENSQT_EXCHANGES_EDGEX_SECRET_KEY=
OPENSQT_EXCHANGES_EDGEX_FEE_RATE=

OPENSQT_EXCHANGES_BACKPACK_API_KEY=
OPENSQT_EXCHANGES_BACKPACK_SECRET_KEY=
OPENSQT_EXCHANGES_BACKPACK_FEE_RATE=

# --- 交易 ---
# OPENSQT_TRADING_SYMBOL=ETHUSDT
# OPENSQT_TRADING_PRICE_INTERVAL=2
# OPENSQT_TRADING_ORDER_QUANTITY=30
# OPENSQT_TRADING_MIN_ORDER_VALUE=20
# OPENSQT_TRADING_BUY_WINDOW_SIZE=10
# OPENSQT_TRADING_SELL_WINDOW_SIZE=10
# OPENSQT_TRADING_RECONCILE_INTERVAL=60
# OPENSQT_TRADING_ORDER_CLEANUP_THRESHOLD=50
# OPENSQT_TRADING_CLEANUP_BATCH_SIZE=20
# OPENSQT_TRADING_MARGIN_LOCK_DURATION_SECONDS=20
# OPENSQT_TRADING_POSITION_SAFETY_CHECK=100

# --- 系统 ---
# OPENSQT_SYSTEM_LOG_LEVEL=INFO
# OPENSQT_SYSTEM_CANCEL_ON_EXIT=true

# --- 风控 ---
# OPENSQT_RISK_CONTROL_ENABLED=true
# OPENSQT_RISK_CONTROL_MONITOR_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT
# OPENSQT_RISK_CONTROL_INTERVAL=1m
# OPENSQT_RISK_CONTROL_VOLUME_MULTIPLIER=3.0
# OPENSQT_RISK_CONTROL_AVERAGE_WINDOW=20
# OPENSQT_RISK_CONTROL_RECOVERY_THRESHOLD=3

# --- 监控面板（容器推荐） ---
OPENSQT_DASHBOARD_LISTEN=0.0.0.0:8787
OPENSQT_DASHBOARD_TOKEN=
# OPENSQT_DASHBOARD_ENABLED=true
# OPENSQT_DASHBOARD_PUSH_INTERVAL_MS=400
# OPENSQT_DASHBOARD_ACCOUNT_REFRESH_SEC=10
